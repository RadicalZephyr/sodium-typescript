{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"noImplicitAny": false, //would be nice to enable this...
		"removeComments": false,
		"preserveConstEnums": true,
		"sourceMap": true,
		"declaration": true,
		"declarationDir": "dist/typings",
		"moduleResolution": "node",
		"diagnostics": true,
		// Only ambient types the library itself needs; keeps unrelated @types
		// packages pulled in by dev tooling out of the compilation.
		"types": [
			"node"
		],
		"lib": [
			"ESNext",
		]
		
	},
	"files": [
		"./src/lib/Lib.ts"
  ],
  "exclude": [
		"node_modules",
		"dist",
		"build",
		"coverage"
  ]
}
