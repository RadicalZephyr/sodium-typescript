{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"noImplicitAny": false, //would be nice to enable this...
		"removeComments": false,
		"preserveConstEnums": true,
		"sourceMap": true,
		"moduleResolution": "node",
		"diagnostics": true,
		"lib": [
			"ESNext",
		]
		
	},
	"files": [
		"./src/lib/Lib.ts"
  ],
  "exclude": [
		"node_modules",
		"dist",
		"build",
		"coverage"
  ]
}
